  steps:
  - highlightLine: -1
    action: none
    value: 0
    param: 
    explanation: 'Waterfall: work flows down through phases in order. A phase must
      finish before the next one starts.'
    narration: {fileID: 0}
  - highlightLine: 0
    action: goto
    value: 0
    param: 
    explanation: 'Requirements: collect and document everything the customer needs.'
    narration: {fileID: 0}
  - highlightLine: 1
    action: goto
    value: 1
    param: 
    explanation: 'Design: plan the architecture and the screens'
    narration: {fileID: 0}
  - highlightLine: 2
    action: goto
    value: 2
    param: 
    explanation: 'Implementation: developers write the code'
    narration: {fileID: 0}
  - highlightLine: 3
    action: goto
    value: 3
    param: 
    explanation: 'Testing: QA checks the finished system. Bugs found now are expensive
      to fix.'
    narration: {fileID: 0}
  - highlightLine: 0
    action: back
    value: 0
    param: 
    explanation: The customer changes a requirement! Waterfall must go back to Requirements
      and repeat the phases
    narration: {fileID: 0}
  - highlightLine: 3
    action: goto
    value: 3
    param: 
    explanation: Design, implementation and testing are repeated with the new requirement
    narration: {fileID: 0}
  - highlightLine: 4
    action: goto
    value: 4
    param: 
    explanation: 'Deployment: the whole system is released to the customer at once.'
    narration: {fileID: 0}
  - highlightLine: 5
    action: goto
    value: 5
    param: 
    explanation: 'Maintenance: fixes and updates after release.'
    narration: {fileID: 0}
